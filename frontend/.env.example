# frontend/.env.example
# Copy this to .env for local development.
# frontend/.env is gitignored — never commit it.
#
# v6.3.2.3 onwards: leave VITE_API_BASE_URL UNSET or empty for local dev.
# The source-file fallback is `''` (empty), which makes axios + fetch use
# relative URLs. Vite's /api + /auth proxy (vite.config.ts) forwards them
# to localhost:8000 — eliminates CORS preflight friction in dev (no more
# stale preflight cache after backend restarts).
#
# Setting an absolute URL still works (escape hatch — e.g. point dev at a
# staging backend), but is no longer required.

# Local dev — leave empty so Vite's proxy handles it
VITE_API_BASE_URL=

# Production — set to absolute backend URL when deploying.
# Typically injected via deploy host's env-var system (Vercel, Render, etc.)
# rather than via this committed file.
# VITE_API_BASE_URL=https://api.yourdomain.com
