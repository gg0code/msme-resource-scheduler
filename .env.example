# Database connection (full URL — used by ORMs like SQLAlchemy / Prisma)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Individual database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
